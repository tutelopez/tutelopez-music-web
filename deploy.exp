#!/usr/bin/expect -f

set timeout -1
set ip [lindex $argv 0]
set port [lindex $argv 1]
set user [lindex $argv 2]
set password [lindex $argv 3]
set command [lindex $argv 4]

spawn ssh -o StrictHostKeyChecking=no -p $port $user@$ip $command
expect {
    "password:" {
        send "$password\r"
        exp_continue
    }
    eof
}
