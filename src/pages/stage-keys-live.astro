    <!-- Modal Lightbox for Screenshots -->
    <div id="image-modal" class="fixed inset-0 z-50 bg-black/90 backdrop-blur-md hidden flex items-center justify-center p-4">
        <div class="relative max-w-5xl w-full">
            <button id="modal-close" class="absolute -top-12 right-0 text-white hover:text-emerald-400 text-3xl font-bold p-2 cursor-pointer">&times;</button>
            <img id="modal-img" src="" alt="Screenshot" class="w-full max-h-[85vh] object-contain rounded-2xl border border-slate-700 shadow-2xl" />
        </div>
    </div>
</MainLayout>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        // --- 1. LIVE LIKES COUNTER & INTERACTION ---
        const likeBtn = document.getElementById('like-btn');
        const likeCounter = document.getElementById('like-counter');
        const likeHeartIcon = document.getElementById('like-heart-icon');

        async function fetchStats() {
            try {
                const res = await fetch('/api/stagekeys-interaction');
                if (res.ok) {
                    const data = await res.json();
                    if (likeCounter && data.likes) {
                        likeCounter.textContent = data.likes.toString();
                    }
                }
            } catch (e) {
                if (likeCounter) likeCounter.textContent = '142';
            }
        }
        fetchStats();

        let hasLiked = localStorage.getItem('stagekeys_liked') === 'true';
        if (hasLiked && likeBtn) {
            likeBtn.classList.add('bg-rose-500/20', 'border-rose-500');
        }

        if (likeBtn) {
            likeBtn.addEventListener('click', async () => {
                if (hasLiked) {
                    // Feedback visual
                    likeBtn.classList.add('scale-110');
                    setTimeout(() => likeBtn.classList.remove('scale-110'), 200);
                    return;
                }

                // Optimistic UI
                hasLiked = true;
                localStorage.setItem('stagekeys_liked', 'true');
                likeBtn.classList.add('bg-rose-500/20', 'border-rose-500');
                if (likeCounter) {
                    const current = parseInt(likeCounter.textContent || '142', 10);
                    likeCounter.textContent = (isNaN(current) ? 143 : current + 1).toString();
                }

                try {
                    const res = await fetch('/api/stagekeys-interaction', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ action: 'like' })
                    });
                    if (res.ok) {
                        const data = await res.json();
                        if (likeCounter && data.likes) {
                            likeCounter.textContent = data.likes.toString();
                        }
                    }
                } catch (err) {
                    console.error('Error enviando like:', err);
                }
            });
        }

        // --- 2. BETA TESTER FORM ---
        const testerForm = document.getElementById('beta-tester-form');
        const testerEmail = document.getElementById('tester-email') as HTMLInputElement | null;
        const testerDevice = document.getElementById('tester-device') as HTMLInputElement | null;
        const testerController = document.getElementById('tester-controller') as HTMLInputElement | null;
        const testerFeedback = document.getElementById('tester-feedback');
        const testerSubmitBtn = document.getElementById('tester-submit-btn');

        if (testerForm && testerEmail) {
            testerForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                const email = testerEmail.value.trim();
                const device = testerDevice ? testerDevice.value.trim() : '';
                const midiController = testerController ? testerController.value.trim() : '';

                if (!email) return;

                if (testerSubmitBtn) {
                    testerSubmitBtn.setAttribute('disabled', 'true');
                    testerSubmitBtn.textContent = 'Registrando...';
                }

                try {
                    const res = await fetch('/api/stagekeys-interaction', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            action: 'tester',
                            email,
                            device,
                            midiController
                        })
                    });

                    const data = await res.json();

                    if (testerFeedback) {
                        testerFeedback.classList.remove('hidden', 'bg-rose-500/20', 'text-rose-300', 'border-rose-500/30', 'bg-emerald-500/20', 'text-emerald-300', 'border-emerald-500/30');
                        testerFeedback.classList.add('border');

                        if (res.ok && data.success) {
                            testerFeedback.classList.add('bg-emerald-500/20', 'text-emerald-300', 'border-emerald-500/30');
                            testerFeedback.textContent = '🎉 ' + data.message;
                            testerForm.reset();
                        } else {
                            testerFeedback.classList.add('bg-rose-500/20', 'text-rose-300', 'border-rose-500/30');
                            testerFeedback.textContent = '❌ ' + (data.error || 'Ocurrió un error al registrarte.');
                        }
                    }
                } catch (err) {
                    if (testerFeedback) {
                        testerFeedback.classList.remove('hidden');
                        testerFeedback.classList.add('bg-rose-500/20', 'text-rose-300', 'border', 'border-rose-500/30');
                        testerFeedback.textContent = '❌ Error de conexión al registrar.';
                    }
                } finally {
                    if (testerSubmitBtn) {
                        testerSubmitBtn.removeAttribute('disabled');
                        testerSubmitBtn.innerHTML = `
                            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                            </svg>
                            <span>Quiero ser Beta Tester Oficial</span>
                        `;
                    }
                }
            });
        }

        // --- 3. SUGGESTIONS FORM ---
        const suggestionForm = document.getElementById('suggestion-form');
        const suggestionText = document.getElementById('suggestion-text') as HTMLTextAreaElement | null;
        const suggestionAuthor = document.getElementById('suggestion-author') as HTMLInputElement | null;
        const suggestionContact = document.getElementById('suggestion-contact') as HTMLInputElement | null;
        const suggestionFeedback = document.getElementById('suggestion-feedback');
        const suggestionSubmitBtn = document.getElementById('suggestion-submit-btn');

        // Quick pills click to fill
        document.querySelectorAll('.quick-pill').forEach(pill => {
            pill.addEventListener('click', () => {
                const text = pill.textContent?.trim() || '';
                if (suggestionText) {
                    suggestionText.value = text;
                    suggestionText.focus();
                }
            });
        });

        if (suggestionForm && suggestionText) {
            suggestionForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                const suggestion = suggestionText.value.trim();
                const author = suggestionAuthor ? suggestionAuthor.value.trim() : '';
                const contact = suggestionContact ? suggestionContact.value.trim() : '';

                if (!suggestion) return;

                if (suggestionSubmitBtn) {
                    suggestionSubmitBtn.setAttribute('disabled', 'true');
                    suggestionSubmitBtn.textContent = 'Enviando...';
                }

                try {
                    const res = await fetch('/api/stagekeys-interaction', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            action: 'suggest',
                            suggestion,
                            author,
                            contact
                        })
                    });

                    const data = await res.json();

                    if (suggestionFeedback) {
                        suggestionFeedback.classList.remove('hidden', 'bg-rose-500/20', 'text-rose-300', 'border-rose-500/30', 'bg-teal-500/20', 'text-teal-300', 'border-teal-500/30');
                        suggestionFeedback.classList.add('border');

                        if (res.ok && data.success) {
                            suggestionFeedback.classList.add('bg-teal-500/20', 'text-teal-300', 'border-teal-500/30');
                            suggestionFeedback.textContent = '💡 ' + data.message;
                            suggestionForm.reset();
                        } else {
                            suggestionFeedback.classList.add('bg-rose-500/20', 'text-rose-300', 'border-rose-500/30');
                            suggestionFeedback.textContent = '❌ ' + (data.error || 'Ocurrió un error al enviar tu sugerencia.');
                        }
                    }
                } catch (err) {
                    if (suggestionFeedback) {
                        suggestionFeedback.classList.remove('hidden');
                        suggestionFeedback.classList.add('bg-rose-500/20', 'text-rose-300', 'border', 'border-rose-500/30');
                        suggestionFeedback.textContent = '❌ Error de conexión al enviar.';
                    }
                } finally {
                    if (suggestionSubmitBtn) {
                        suggestionSubmitBtn.removeAttribute('disabled');
                        suggestionSubmitBtn.innerHTML = `
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                            </svg>
                            <span>Enviar Sugerencia a Tute López</span>
                        `;
                    }
                }
            });
        }

        // --- 4. LIGHTBOX MODAL ---
        const modal = document.getElementById('image-modal');
        const modalImg = document.getElementById('modal-img') as HTMLImageElement | null;
        const modalClose = document.getElementById('modal-close');

        document.querySelectorAll('.image-card').forEach(card => {
            card.addEventListener('click', () => {
                const src = card.getAttribute('data-img');
                if (modal && modalImg && src) {
                    modalImg.src = src;
                    modal.classList.remove('hidden');
                }
            });
        });

        if (modalClose && modal) {
            modalClose.addEventListener('click', () => {
                modal.classList.add('hidden');
            });
        }
        if (modal) {
            modal.addEventListener('click', (e) => {
                if (e.target === modal) {
                    modal.classList.add('hidden');
                }
            });
        }
    });
</script>
