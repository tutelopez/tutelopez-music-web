                >
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                    </svg>
                    <span>Enviar Sugerencia a Tute López</span>
                </button>
            </form>
        </div>
    </section>

    <!-- SECTION: FAQ -->
    <section class="py-16 max-w-4xl mx-auto px-4">
        <div class="text-center mb-10">
            <h2 class="text-3xl font-bold text-white mb-2">Preguntas Frecuentes</h2>
            <p class="text-slate-400 text-sm">Todo lo que necesitas saber antes del lanzamiento.</p>
        </div>

        <div class="space-y-4">
            <details class="glass-panel p-5 rounded-2xl group border border-slate-800 cursor-pointer">
                <summary class="flex justify-between items-center font-bold text-white text-base">
                    <span>¿Qué versión de Android necesito?</span>
                    <span class="text-emerald-400 group-open:rotate-180 transition-transform">▼</span>
                </summary>
                <p class="text-slate-300 text-sm mt-3 leading-relaxed">
                    Stage Keys Live está optimizado para dispositivos con <strong>Android 8.0 (Oreo) o superior</strong> que cuenten con soporte para USB OTG (Host MIDI). Para disfrutar de la mínima latencia con el motor Google Oboe, se recomiendan dispositivos con Android 10+.
