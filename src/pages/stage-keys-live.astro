                    ></textarea>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label for="suggestion-author" class="block text-sm font-semibold text-slate-200 mb-1.5">
                            Tu Nombre o Alias (opcional)
                        </label>
                        <input 
                            type="text" 
                            id="suggestion-author" 
                            placeholder="Ej: Mateo" 
                            class="w-full px-4 py-2.5 rounded-xl bg-slate-950/70 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-teal-400 transition-all text-sm"
                        />
