---
import MainLayout from '../layouts/MainLayout.astro';
import { SITE_TITLE } from '../consts';

const pageTitle = `Stage Keys Live - El MainStage para Android | ${SITE_TITLE}`;
const pageDescription = "Stage Keys Live es una app para Android desarrollada con Kotlin y C++ Oboe para tocar en vivo con librerías SF2, Split y Layer, y soporte de controladores MIDI.";
---

<MainLayout title={pageTitle} description={pageDescription}>
    <!-- Top Ambient Lights -->
    <div class="relative overflow-hidden pt-12 pb-20">
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[700px] h-[400px] bg-gradient-to-tr from-emerald-600/20 via-cyan-500/20 to-blue-600/20 rounded-full blur-3xl -z-10 pointer-events-none"></div>

        <!-- Hero Section -->
        <div class="max-w-5xl mx-auto px-4 text-center">
            <!-- Development Stage Badge -->
            <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs md:text-sm font-semibold mb-8 backdrop-blur-md shadow-lg shadow-emerald-950/20">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-ping"></span>
                <span>PROYECTO EN DESARROLLO ACTIVO • CLOSED TESTING TRACK DE GOOGLE PLAY</span>
            </div>

            <!-- App Icon with Neon Glow -->
            <div class="relative inline-block mb-6">
                <div class="absolute -inset-4 bg-gradient-to-r from-emerald-500 to-cyan-500 rounded-3xl blur-2xl opacity-40 animate-pulse"></div>
                <img 
                    src="/images/stagekeyslive-icon.png" 
                    alt="Stage Keys Live Icon" 
                    class="relative w-28 h-28 md:w-36 md:h-36 rounded-3xl shadow-2xl border-2 border-emerald-400/40 object-cover mx-auto transform hover:scale-105 transition-all duration-300"
                />
            </div>

            <h1 class="text-4xl md:text-6xl lg:text-7xl font-black text-white tracking-tight mb-4">
                STAGE KEYS <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-teal-300 to-cyan-400">LIVE</span>
            </h1>

            <p class="text-lg md:text-2xl text-slate-300 font-medium max-w-3xl mx-auto mb-8 leading-relaxed">
                El <strong class="text-emerald-400">MainStage para Android</strong> que todo tecladista worship estaba esperando. Conecta tu teclado MIDI por USB o Bluetooth, carga librerías <code class="text-xs bg-slate-800 px-2 py-1 rounded text-cyan-300">.sf2</code> y toca en vivo sin laptop.
            </p>

            <!-- Live Action Counters & CTAs -->
            <div class="flex flex-wrap items-center justify-center gap-4 mb-14">
                <!-- Like Button -->
                <button 
                    id="like-btn" 
                    class="group flex items-center gap-3 px-6 py-3.5 rounded-2xl bg-slate-900/80 hover:bg-slate-800 border border-rose-500/40 text-rose-400 font-bold text-base transition-all transform hover:scale-105 shadow-xl shadow-rose-950/30 cursor-pointer"
                >
                    <svg id="like-heart-icon" class="w-6 h-6 transition-transform group-hover:scale-125 group-active:scale-95 text-rose-500 fill-rose-500" viewBox="0 0 24 24">
                        <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                    </svg>
                    <span>Apoyar Proyecto</span>
                    <span id="like-counter" class="px-2.5 py-0.5 rounded-full bg-rose-500/20 text-rose-300 text-sm font-extrabold">...</span>
                </button>

                <!-- Beta Tester Jump Button -->
                <a 
                    href="#beta-tester" 
                    class="flex items-center gap-2.5 px-8 py-3.5 rounded-2xl bg-gradient-to-r from-emerald-500 to-cyan-500 hover:from-emerald-400 hover:to-cyan-400 text-slate-950 font-black text-base transition-all transform hover:scale-105 shadow-xl shadow-emerald-500/30"
                >
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
                    </svg>
                    <span>Ser Beta Tester en Play Store</span>
                </a>

                <!-- GitHub Link -->
                <a 
                    href="https://github.com/tutelopez/StageKeysLive" 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="flex items-center gap-2 px-5 py-3.5 rounded-2xl bg-slate-900/60 hover:bg-slate-800 border border-slate-700 text-slate-300 font-semibold text-sm transition-all"
                >
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
                    <span>Ver Código en GitHub</span>
                </a>
            </div>
        </div>

        <!-- Real In-App Screenshots Gallery -->
        <div class="max-w-6xl mx-auto px-4 mt-4">
            <div class="text-center mb-10">
                <span class="text-xs uppercase tracking-widest text-emerald-400 font-bold block mb-2">Vistas Reales de la Aplicación</span>
                <h2 class="text-3xl md:text-4xl font-extrabold text-white">Diseñada para el Escenario</h2>
                <p class="text-slate-400 max-w-xl mx-auto mt-2">Capturas directas de Stage Keys Live funcionando en dispositivos Android.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Screenshot 1 -->
                <div class="glass-panel overflow-hidden border border-emerald-500/20 hover:border-emerald-500/60 transition-all duration-300 group flex flex-col">
                    <div class="relative bg-slate-950 overflow-hidden cursor-pointer image-card" data-img="/images/stagekeys/stage1.jpg">
                        <img 
                            src="/images/stagekeys/stage1.jpg" 
                            alt="Mixer Principal y Teclado en Vivo" 
                            class="w-full h-64 object-cover object-center group-hover:scale-105 transition-transform duration-500"
                        />
                        <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-transparent to-transparent opacity-80"></div>
                        <div class="absolute top-3 left-3 px-2.5 py-1 rounded-md bg-emerald-500 text-slate-950 text-[10px] font-black tracking-wider uppercase">
                            Main Concert
                        </div>
                    </div>
                    <div class="p-6 flex-1 flex flex-col justify-between">
                        <div>
                            <h3 class="text-xl font-bold text-white mb-2 group-hover:text-emerald-400 transition-colors">Mixer en Vivo & Teclado Táctil</h3>
                            <p class="text-slate-300 text-sm leading-relaxed">
                                Control de canales por capas con faders independientes, medidores de señal en tiempo real, BPM, Tap Tempo, botón REC y teclado virtual táctil con rueda de modulación y pitch bend.
                            </p>
                        </div>
                        <div class="mt-4 pt-4 border-t border-slate-800 flex items-center justify-between text-xs text-slate-400">
                            <span>✨ Mapeo nanoKONTROL</span>
                            <span class="text-emerald-400 font-bold">120 BPM • Metrónomo</span>
                        </div>
                    </div>
                </div>

                <!-- Screenshot 2 -->
                <div class="glass-panel overflow-hidden border border-cyan-500/20 hover:border-cyan-500/60 transition-all duration-300 group flex flex-col">
                    <div class="relative bg-slate-950 overflow-hidden cursor-pointer image-card" data-img="/images/stagekeys/stage2.jpg">
                        <img 
                            src="/images/stagekeys/stage2.jpg" 
                            alt="Configurador de Parches y SoundFonts" 
                            class="w-full h-64 object-cover object-center group-hover:scale-105 transition-transform duration-500"
                        />
                        <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-transparent to-transparent opacity-80"></div>
                        <div class="absolute top-3 left-3 px-2.5 py-1 rounded-md bg-cyan-500 text-slate-950 text-[10px] font-black tracking-wider uppercase">
                            SF2 Engine
                        </div>
                    </div>
                    <div class="p-6 flex-1 flex flex-col justify-between">
                        <div>
                            <h3 class="text-xl font-bold text-white mb-2 group-hover:text-cyan-400 transition-colors">Ajuste de Parches & Instrumentos</h3>
                            <p class="text-slate-300 text-sm leading-relaxed">
                                Carga SoundFonts (.sf2) directamente desde la memoria interna o tarjeta SD de tu Android. Asigna instrumentos, bancos y preajustes con respuesta inmediata.
                            </p>
                        </div>
                        <div class="mt-4 pt-4 border-t border-slate-800 flex items-center justify-between text-xs text-slate-400">
                            <span>📂 .SF2 SoundFonts</span>
                            <span class="text-cyan-400 font-bold">FluidSynth JNI</span>
                        </div>
                    </div>
                </div>

                <!-- Screenshot 3 -->
                <div class="glass-panel overflow-hidden border border-teal-500/20 hover:border-teal-500/60 transition-all duration-300 group flex flex-col">
                    <div class="relative bg-slate-950 overflow-hidden cursor-pointer image-card" data-img="/images/stagekeys/stage3.jpg">
                        <img 
                            src="/images/stagekeys/stage3.jpg" 
                            alt="Editor Visual de Split y Layer" 
                            class="w-full h-64 object-cover object-center group-hover:scale-105 transition-transform duration-500"
                        />
                        <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-transparent to-transparent opacity-80"></div>
                        <div class="absolute top-3 left-3 px-2.5 py-1 rounded-md bg-teal-400 text-slate-950 text-[10px] font-black tracking-wider uppercase">
                            Split & Layer
                        </div>
                    </div>
                    <div class="p-6 flex-1 flex flex-col justify-between">
                        <div>
                            <h3 class="text-xl font-bold text-white mb-2 group-hover:text-teal-400 transition-colors">Editor Visual de Zonas</h3>
                            <p class="text-slate-300 text-sm leading-relaxed">
                                Configura divisiones del teclado con colores intuitivos. Asigna bajos a la mano izquierda, piano acústico al centro y pads/leads a la mano derecha con rangos dinámicos de velocidad.
                            </p>
                        </div>
                        <div class="mt-4 pt-4 border-t border-slate-800 flex items-center justify-between text-xs text-slate-400">
                            <span>🎹 Zonas por Color</span>
                            <span class="text-teal-400 font-bold">Curvas de Velocity</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Technical Architecture Highlights -->
    <section class="py-16 max-w-6xl mx-auto px-4">
        <div class="text-center mb-14">
            <span class="text-xs uppercase tracking-widest text-cyan-400 font-bold block mb-2">Ingeniería de Alto Rendimiento</span>
            <h2 class="text-3xl md:text-5xl font-extrabold text-white">¿Por qué es diferente a otras apps?</h2>
            <p class="text-slate-400 max-w-2xl mx-auto mt-3">
                No es un reproductor de MIDI genérico. Está programado desde cero para resistir la exigencia de un recital en vivo.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <!-- Feature 1 -->
            <div class="glass-panel p-8 border border-slate-800 hover:border-emerald-500/40 transition-colors group">
                <div class="w-14 h-14 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 mb-6 group-hover:scale-110 transition-transform">
                    <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                    </svg>
                </div>
                <h3 class="text-xl font-bold text-white mb-3">Google Oboe C++ Engine</h3>
                <p class="text-slate-300 text-sm leading-relaxed">
                    Utiliza la librería de audio nativa de Google en C++ para comunicarse con el chip de sonido de tu Android con la menor latencia posible (&lt; 10ms garantizados en dispositivos modernos).
                </p>
            </div>

            <!-- Feature 2 -->
            <div class="glass-panel p-8 border border-slate-800 hover:border-cyan-500/40 transition-colors group">
                <div class="w-14 h-14 rounded-2xl bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-cyan-400 mb-6 group-hover:scale-110 transition-transform">
                    <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" />
                    </svg>
                </div>
                <h3 class="text-xl font-bold text-white mb-3">FluidSynth .SF2 SoundFonts</h3>
                <p class="text-slate-300 text-sm leading-relaxed">
                    Carga instrumentos de worship, sintetizadores analógicos, coros y pianos en formato SoundFont .sf2, optimizados para consumir poca memoria RAM sin perder fidelidad acústica.
                </p>
            </div>

            <!-- Feature 3 -->
            <div class="glass-panel p-8 border border-slate-800 hover:border-teal-500/40 transition-colors group">
                <div class="w-14 h-14 rounded-2xl bg-teal-500/10 border border-teal-500/30 flex items-center justify-center text-teal-400 mb-6 group-hover:scale-110 transition-transform">
                    <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z" />
                    </svg>
                </div>
                <h3 class="text-xl font-bold text-white mb-3">Seamless Spillover</h3>
                <p class="text-slate-300 text-sm leading-relaxed">
                    Al pasar de una canción rápida a una balada suave, las notas sostenidas con el pedal de sustain no se apagan bruscamente. El cambio de patch es 100% fluido e ininterrumpido.
                </p>
            </div>

            <!-- Feature 4 -->
            <div class="glass-panel p-8 border border-slate-800 hover:border-yellow-500/40 transition-colors group">
                <div class="w-14 h-14 rounded-2xl bg-yellow-500/10 border border-yellow-500/30 flex items-center justify-center text-yellow-400 mb-6 group-hover:scale-110 transition-transform">
                    <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
                    </svg>
                </div>
                <h3 class="text-xl font-bold text-white mb-3">Modo Mixer nanoKONTROL</h3>
                <p class="text-slate-300 text-sm leading-relaxed">
                    Conecta un Korg nanoKONTROL2 o cualquier controlador con faders mediante cable USB OTG y controla los volúmenes de tus capas exactamente como lo haces en MainStage.
                </p>
            </div>

            <!-- Feature 5 -->
            <div class="glass-panel p-8 border border-slate-800 hover:border-indigo-500/40 transition-colors group">
                <div class="w-14 h-14 rounded-2xl bg-indigo-500/10 border border-indigo-500/30 flex items-center justify-center text-indigo-400 mb-6 group-hover:scale-110 transition-transform">
                    <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 100-6 3 3 0 000 6z" />
                    </svg>
                </div>
                <h3 class="text-xl font-bold text-white mb-3">Audio en Segundo Plano</h3>
                <p class="text-slate-300 text-sm leading-relaxed">
                    El servicio de audio continúa sonando sin interrupción aunque apagues la pantalla de tu tablet para ahorrar batería o abras una aplicación de partituras como MobileSheets.
                </p>
            </div>

            <!-- Feature 6 -->
            <div class="glass-panel p-8 border border-slate-800 hover:border-pink-500/40 transition-colors group">
                <div class="w-14 h-14 rounded-2xl bg-pink-500/10 border border-pink-500/30 flex items-center justify-center text-pink-400 mb-6 group-hover:scale-110 transition-transform">
                    <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.141 0M1.394 9.393c5.857-5.857 15.355-5.857 21.213 0" />
                    </svg>
                </div>
                <h3 class="text-xl font-bold text-white mb-3">USB & Bluetooth MIDI</h3>
                <p class="text-slate-300 text-sm leading-relaxed">
                    Soporte directo para teclados Yamaha, Roland, Nord, Arturia, Novation o adaptadores Bluetooth MIDI (CME Widi Master, etc.) sin controladores adicionales.
                </p>
            </div>
        </div>
    </section>

    <!-- SECTION: GOOGLE PLAY CLOSED BETA TESTER REGISTRATION -->
    <section id="beta-tester" class="py-16 max-w-4xl mx-auto px-4 scroll-mt-24">
        <div class="glass-panel p-8 md:p-12 border-2 border-emerald-500/50 shadow-2xl shadow-emerald-950/40 relative overflow-hidden">
            <div class="absolute -right-20 -top-20 w-80 h-80 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>

            <div class="flex items-center gap-3 text-emerald-400 mb-3">
                <svg class="w-6 h-6 animate-spin" style="animation-duration: 3s;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <span class="text-xs md:text-sm font-black uppercase tracking-widest">Pista de Pruebas Cerradas (Closed Testing)</span>
            </div>

            <h2 class="text-3xl md:text-4xl font-black text-white mb-4">
                Únete como Beta Tester en Google Play
            </h2>

            <p class="text-slate-300 text-base md:text-lg mb-6 leading-relaxed">
                Google Play Console exige que una aplicación nueva sea probada de forma continua por al menos <strong class="text-emerald-400">14 a 20 evaluadores</strong> registrados antes de permitir su publicación abierta a todo el público.
            </p>
            <p class="text-slate-400 text-sm mb-8">
                Si tienes un celular o tablet Android y quieres tener acceso anticipado exclusivo, ingresa tu <strong>correo de Google (Gmail)</strong> con el que accedes a tu Play Store:
            </p>

            <!-- Form -->
            <form id="beta-tester-form" class="space-y-4">
                <div>
                    <label for="tester-email" class="block text-sm font-semibold text-slate-200 mb-1.5">
                        Correo de Google / Gmail <span class="text-rose-400">*</span>
                    </label>
                    <input 
                        type="email" 
                        id="tester-email" 
                        required 
                        placeholder="tu-correo@gmail.com" 
                        class="w-full px-4 py-3.5 rounded-xl bg-slate-950/70 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-emerald-400 focus:border-transparent transition-all"
                    />
                    <span class="text-xs text-slate-500 mt-1 block">Debe ser la cuenta de Google vinculada a tu celular o tablet.</span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label for="tester-device" class="block text-sm font-semibold text-slate-200 mb-1.5">
                            Modelo de Dispositivo / Tablet
                        </label>
                        <input 
                            type="text" 
                            id="tester-device" 
                            placeholder="Ej: Samsung Galaxy Tab S8, Xiaomi Pad 6..." 
                            class="w-full px-4 py-3 rounded-xl bg-slate-950/70 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-emerald-400 transition-all text-sm"
                        />
                    </div>
                    <div>
                        <label for="tester-controller" class="block text-sm font-semibold text-slate-200 mb-1.5">
                            Teclado o Controlador MIDI
                        </label>
                        <input 
                            type="text" 
                            id="tester-controller" 
                            placeholder="Ej: Arturia KeyLab, Korg nanoKONTROL2..." 
                            class="w-full px-4 py-3 rounded-xl bg-slate-950/70 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-emerald-400 transition-all text-sm"
                        />
                    </div>
                </div>

                <div id="tester-feedback" class="hidden p-4 rounded-xl text-sm font-medium"></div>

                <button 
                    type="submit" 
                    id="tester-submit-btn" 
                    class="w-full py-4 rounded-xl bg-gradient-to-r from-emerald-500 to-cyan-500 hover:from-emerald-400 hover:to-cyan-400 text-slate-950 font-black text-base transition-all transform hover:scale-[1.01] shadow-xl shadow-emerald-500/25 flex items-center justify-center gap-2 cursor-pointer"
                >
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
