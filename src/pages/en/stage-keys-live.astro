        </div>
    </section>

    <!-- Modal Lightbox for Screenshots (Full 2400x1080 View) -->
    <div id="image-modal" class="fixed inset-0 z-50 bg-black/90 backdrop-blur-md hidden flex items-center justify-center p-4">
        <div class="relative max-w-6xl w-full">
            <button id="modal-close" class="absolute -top-12 right-0 text-white hover:text-emerald-400 text-3xl font-bold p-2 cursor-pointer transition-colors">&times;</button>
            <img id="modal-img" src="" alt="Screenshot Full Resolution" class="w-full max-h-[85vh] object-contain rounded-2xl border border-slate-700 shadow-2xl" />
        </div>
    </div>
</MainLayout>

<script>
    import gsap from 'gsap';

    document.addEventListener('DOMContentLoaded', () => {
        // --- 1. GSAP ENTRANCE ANIMATIONS (Make Interfaces Feel Better) ---
        gsap.from('.hero-anim', {
            y: 28,
            opacity: 0,
            duration: 0.85,
            stagger: 0.08,
            ease: 'power3.out'
        });

        // Floating ambient glow subtle drift
        const ambientGlow = document.getElementById('ambient-glow');
        if (ambientGlow) {
            gsap.to(ambientGlow, {
                scale: 1.15,
                opacity: 0.8,
                duration: 6,
                repeat: -1,
                yoyo: true,
                ease: 'sine.inOut'
            });
        }

        // --- 2. INTERACTIVE APP SHOWCASE TABS ---
        const tabsData: Record<string, { img: string; badge: string; title: string; desc: string; tags: string[] }> = {
            mixer: {
                img: '/images/stagekeys/stage-mixer.jpg',
                badge: 'Mixer & Virtual Keyboard',
                title: 'Live Mixer & Touch Keyboard',
                desc: 'Complete layer volume control with virtual faders, reactive VU meters per channel, Mute/Solo switches, dedicated Reverb, Chorus and Cutoff knobs, Tap Tempo, live MIDI recorder, and on-screen keyboard with pitch bend and modulation wheel.',
                tags: ['Virtual Faders', '120 BPM • Tap', 'VU Meters']
            },
            pads: {
                img: '/images/stagekeys/stage-pads.jpg',
                badge: 'Ambient Worship Pads',
                title: 'Continuous Atmospheric Drone Pads (12 Keys)',
                desc: 'Atmospheric drone pad engine (Shimmer Pad, Warm Pad) across all 12 musical keys. Transition between songs with seamless crossfade without awkward pauses during prayer or ministry.',
                tags: ['12 Musical Keys', 'Shimmer Reverb', 'Smooth Crossfade']
            },
            splits: {
                img: '/images/stagekeys/stage-splits.jpg',
                badge: 'Split & Layer Zones',
                title: 'Visual Split & Layer Editor',
                desc: 'Set note ranges from A0 to C8 by dragging directly on the touch keyboard bar. Assign bass to your left hand, piano to center, and leads to right with neon color markers.',
                tags: ['Octavas A0 - C8', 'Color Coded Zones', 'Velocity Curves']
            },
            midi: {
                img: '/images/stagekeys/stage-midi.jpg',
                badge: 'MIDI Learn System',
                title: 'Physical Real-Time MIDI Mapping',
                desc: 'Plug in any control surface like Korg nanoKONTROL2 or master keyboard. Assign faders, effect knobs, and mute buttons with a single touch using instant MIDI Learn.',
                tags: ['nanoKONTROL2', 'USB OTG & BLE', 'Program Change']
            },
            audio: {
                img: '/images/stagekeys/stage-audio.jpg',
                badge: 'Google Oboe C++ Engine',
                title: 'Low-Latency Audio Settings',
                desc: 'Direct control over Android native audio subsystem: sample rate selection (48kHz), buffer sizes, latency diagnostics, and real-time xRuns buffer underrun counter.',
                tags: ['< 10ms Latency', '48 kHz / 24-bit', 'xRuns Diagnostic']
            },
            dashboard: {
                img: '/images/stagekeys/stage-dashboard.jpg',
                badge: 'Concert Manager',
                title: 'Sets & Concerts Manager',
                desc: 'Organize setlists for each worship service or gig, import and export .skz concert files, and auto-sync backups to Google Drive cloud storage.',
                tags: ['Google Drive Backup', 'Sets .skz', 'Zero Laptop']
            }
        };

        const tabButtons = document.querySelectorAll('.tab-btn');
        const showcaseImg = document.getElementById('showcase-img') as HTMLImageElement | null;
        const showcaseCard = document.getElementById('showcase-card');
        const showcaseBadge = document.getElementById('showcase-badge');
        const showcaseTitle = document.getElementById('showcase-title');
        const showcaseDesc = document.getElementById('showcase-desc');
        const showcaseTags = document.getElementById('showcase-tags');

        tabButtons.forEach(btn => {
            btn.addEventListener('click', () => {
                const tabKey = btn.getAttribute('data-tab') || 'mixer';
                const data = tabsData[tabKey];
                if (!data) return;

                // Update active button classes
                tabButtons.forEach(b => {
                    b.classList.remove('bg-emerald-500/20', 'text-emerald-300', 'border-emerald-500/40', 'shadow-lg', 'shadow-emerald-950/20');
                    b.classList.add('bg-slate-900/60', 'text-slate-400', 'border-slate-800');
                });
                btn.classList.remove('bg-slate-900/60', 'text-slate-400', 'border-slate-800');
                btn.classList.add('bg-emerald-500/20', 'text-emerald-300', 'border-emerald-500/40', 'shadow-lg', 'shadow-emerald-950/20');

                // GSAP Transition on Image & Texts
                if (showcaseImg && showcaseCard) {
                    gsap.to(showcaseImg, {
                        opacity: 0.3,
                        scale: 0.98,
                        duration: 0.18,
                        ease: 'power2.in',
                        onComplete: () => {
                            showcaseImg.src = data.img;
                            showcaseCard.setAttribute('data-img', data.img);
                            if (showcaseBadge) showcaseBadge.textContent = data.badge;
                            if (showcaseTitle) showcaseTitle.textContent = data.title;
                            if (showcaseDesc) showcaseDesc.textContent = data.desc;
                            if (showcaseTags) {
                                showcaseTags.innerHTML = data.tags.map(t => 
                                    `<span class="px-2.5 py-1 rounded-md bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 text-xs font-bold">${t}</span>`
                                ).join('');
                            }

                            gsap.to(showcaseImg, {
                                opacity: 1,
                                scale: 1,
                                duration: 0.35,
                                ease: 'power3.out'
                            });
                        }
                    });
                }
            });
        });

        // --- 3. LIVE LIKE COUNTER WITH GSAP FLOATING HEARTS ---
        const likeBtn = document.getElementById('like-btn');
        const likeCounter = document.getElementById('like-counter');
        const likeHeartIcon = document.getElementById('like-heart-icon');

        async function fetchStats() {
            try {
                const res = await fetch('/api/stagekeys-interaction');
                if (res.ok) {
                    const data = await res.json();
                    if (likeCounter && data.likes) {
                        likeCounter.textContent = data.likes.toString();
                    }
                }
            } catch (e) {
                if (likeCounter) likeCounter.textContent = '148';
            }
        }
        fetchStats();

        let hasLiked = localStorage.getItem('stagekeys_liked') === 'true';
        if (hasLiked && likeBtn) {
            likeBtn.classList.add('bg-rose-500/20', 'border-rose-500');
        }

        function createFloatingHeart(x: number, y: number) {
            const heart = document.createElement('div');
            heart.innerHTML = '❤️';
            heart.style.position = 'fixed';
            heart.style.left = `${x}px`;
            heart.style.top = `${y}px`;
            heart.style.fontSize = `${Math.random() * 12 + 16}px`;
            heart.style.pointerEvents = 'none';
            heart.style.zIndex = '9999';
            document.body.appendChild(heart);

            gsap.to(heart, {
                y: y - 80 - Math.random() * 50,
                x: x + (Math.random() - 0.5) * 60,
                opacity: 0,
                scale: 1.4,
                duration: 1.2,
                ease: 'power2.out',
                onComplete: () => heart.remove()
            });
        }

        if (likeBtn) {
            likeBtn.addEventListener('click', async (e) => {
                const rect = likeBtn.getBoundingClientRect();
                const clickX = e.clientX || (rect.left + rect.width / 2);
                const clickY = e.clientY || rect.top;

                // Spawn 3 floating hearts
                for (let i = 0; i < 3; i++) {
                    setTimeout(() => createFloatingHeart(clickX, clickY), i * 120);
                }

                // Bounce like icon with GSAP
                if (likeHeartIcon) {
                    gsap.fromTo(likeHeartIcon, 
                        { scale: 0.8 }, 
                        { scale: 1.35, duration: 0.25, yoyo: true, repeat: 1, ease: 'back.out(2)' }
                    );
                }

                if (hasLiked) return;

                // Optimistic UI
                hasLiked = true;
                localStorage.setItem('stagekeys_liked', 'true');
                likeBtn.classList.add('bg-rose-500/20', 'border-rose-500');
                if (likeCounter) {
                    const current = parseInt(likeCounter.textContent || '148', 10);
                    likeCounter.textContent = (isNaN(current) ? 149 : current + 1).toString();
                }

                try {
                    const res = await fetch('/api/stagekeys-interaction', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ action: 'like' })
                    });
                    if (res.ok) {
                        const data = await res.json();
                        if (likeCounter && data.likes) {
                            likeCounter.textContent = data.likes.toString();
                        }
                    }
                } catch (err) {
                    console.error('Error sending like:', err);
                }
            });
        }

        // --- 4. BETA TESTER FORM ---
        const testerForm = document.getElementById('beta-tester-form');
        const testerEmail = document.getElementById('tester-email') as HTMLInputElement | null;
        const testerDevice = document.getElementById('tester-device') as HTMLInputElement | null;
        const testerController = document.getElementById('tester-controller') as HTMLInputElement | null;
        const testerFeedback = document.getElementById('tester-feedback');
        const testerSubmitBtn = document.getElementById('tester-submit-btn');

        if (testerForm && testerEmail) {
            testerForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                const email = testerEmail.value.trim();
                const device = testerDevice ? testerDevice.value.trim() : '';
                const midiController = testerController ? testerController.value.trim() : '';

                if (!email) return;

                if (testerSubmitBtn) {
                    testerSubmitBtn.setAttribute('disabled', 'true');
                    testerSubmitBtn.textContent = 'Registering on Google Play...';
                }

                try {
                    const res = await fetch('/api/stagekeys-interaction', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            action: 'tester',
                            email,
                            device,
                            midiController
                        })
                    });

                    const data = await res.json();

                    if (testerFeedback) {
                        testerFeedback.classList.remove('hidden', 'bg-rose-500/20', 'text-rose-300', 'border-rose-500/30', 'bg-emerald-500/20', 'text-emerald-300', 'border-emerald-500/30');
                        testerFeedback.classList.add('border');

                        if (res.ok && data.success) {
                            testerFeedback.classList.add('bg-emerald-500/20', 'text-emerald-300', 'border-emerald-500/30');
                            testerFeedback.textContent = '🎉 ' + (data.message || 'You have been registered for closed beta testing!');
                            testerForm.reset();
                        } else {
                            testerFeedback.classList.add('bg-rose-500/20', 'text-rose-300', 'border-rose-500/30');
                            testerFeedback.textContent = '❌ ' + (data.error || 'An error occurred while registering.');
                        }
                    }
                } catch (err) {
                    if (testerFeedback) {
                        testerFeedback.classList.remove('hidden');
                        testerFeedback.classList.add('bg-rose-500/20', 'text-rose-300', 'border', 'border-rose-500/30');
                        testerFeedback.textContent = '❌ Connection error while registering.';
                    }
                } finally {
                    if (testerSubmitBtn) {
                        testerSubmitBtn.removeAttribute('disabled');
                        testerSubmitBtn.innerHTML = `
                            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                            </svg>
                            <span>Request Official Beta Tester Access</span>
                        `;
                    }
                }
            });
        }

        // --- 5. COMMUNITY SUGGESTIONS ---
        const suggestionForm = document.getElementById('suggestion-form');
        const suggestionText = document.getElementById('suggestion-text') as HTMLTextAreaElement | null;
        const suggestionAuthor = document.getElementById('suggestion-author') as HTMLInputElement | null;
        const suggestionContact = document.getElementById('suggestion-contact') as HTMLInputElement | null;
        const suggestionFeedback = document.getElementById('suggestion-feedback');
        const suggestionSubmitBtn = document.getElementById('suggestion-submit-btn');

        document.querySelectorAll('.quick-pill').forEach(pill => {
            pill.addEventListener('click', () => {
                const text = pill.textContent?.trim() || '';
                if (suggestionText) {
                    suggestionText.value = text;
                    suggestionText.focus();
                    gsap.fromTo(suggestionText, { scale: 0.99 }, { scale: 1, duration: 0.2 });
                }
            });
        });

        if (suggestionForm && suggestionText) {
            suggestionForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                const suggestion = suggestionText.value.trim();
                const author = suggestionAuthor ? suggestionAuthor.value.trim() : '';
                const contact = suggestionContact ? suggestionContact.value.trim() : '';

                if (!suggestion) return;

                if (suggestionSubmitBtn) {
                    suggestionSubmitBtn.setAttribute('disabled', 'true');
                    suggestionSubmitBtn.textContent = 'Submitting suggestion...';
                }

                try {
                    const res = await fetch('/api/stagekeys-interaction', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            action: 'suggest',
                            suggestion,
                            author,
                            contact
                        })
                    });

                    const data = await res.json();

                    if (suggestionFeedback) {
                        suggestionFeedback.classList.remove('hidden', 'bg-rose-500/20', 'text-rose-300', 'border-rose-500/30', 'bg-teal-500/20', 'text-teal-300', 'border-teal-500/30');
                        suggestionFeedback.classList.add('border');

                        if (res.ok && data.success) {
                            suggestionFeedback.classList.add('bg-teal-500/20', 'text-teal-300', 'border-teal-500/30');
                            suggestionFeedback.textContent = '💡 ' + (data.message || 'Thank you for your suggestion!');
                            suggestionForm.reset();
                        } else {
                            suggestionFeedback.classList.add('bg-rose-500/20', 'text-rose-300', 'border-rose-500/30');
                            suggestionFeedback.textContent = '❌ ' + (data.error || 'An error occurred while submitting your suggestion.');
                        }
                    }
                } catch (err) {
                    if (suggestionFeedback) {
                        suggestionFeedback.classList.remove('hidden');
                        suggestionFeedback.classList.add('bg-rose-500/20', 'text-rose-300', 'border', 'border-rose-500/30');
                        suggestionFeedback.textContent = '❌ Connection error while submitting.';
                    }
                } finally {
                    if (suggestionSubmitBtn) {
                        suggestionSubmitBtn.removeAttribute('disabled');
                        suggestionSubmitBtn.innerHTML = `
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                            </svg>
                            <span>Submit Feature Request to Tute Lopez</span>
                        `;
                    }
                }
            });
        }

        // --- 6. LIGHTBOX MODAL ---
        const modal = document.getElementById('image-modal');
        const modalImg = document.getElementById('modal-img') as HTMLImageElement | null;
        const modalClose = document.getElementById('modal-close');

        document.querySelectorAll('.image-card').forEach(card => {
            card.addEventListener('click', () => {
                const src = card.getAttribute('data-img');
                if (modal && modalImg && src) {
                    modalImg.src = src;
                    modal.classList.remove('hidden');
                    gsap.fromTo(modalImg, { scale: 0.9, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.3, ease: 'power3.out' });
                }
            });
        });

        if (modalClose && modal) {
            modalClose.addEventListener('click', () => {
                modal.classList.add('hidden');
            });
        }
        if (modal) {
            modal.addEventListener('click', (e) => {
                if (e.target === modal) {
                    modal.classList.add('hidden');
                }
            });
        }
    });
</script>
