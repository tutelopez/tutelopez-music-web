---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Contacto - TuteLopez Music" description="Ponte en contacto conmigo a través de mis redes sociales.">
    <div class="max-w-4xl mx-auto py-16 px-4 sm:px-6 lg:px-8 text-center">
        <!-- Icon/Illustration -->
        <div class="w-24 h-24 mx-auto bg-gradient-to-br from-blue-400 to-indigo-500 rounded-full flex items-center justify-center mb-8 shadow-2xl shadow-indigo-500/30">
            <svg class="w-12 h-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
        </div>

        <h1 class="text-4xl md:text-5xl font-extrabold mb-6 text-white">¡Conectemos!</h1>
        
        <p class="text-xl text-slate-300 mb-12 max-w-2xl mx-auto leading-relaxed">
            Me encanta escuchar a otros músicos. Si tienes dudas sobre los recursos, quieres colaborar, o simplemente saludar, puedes encontrarme activo en mis redes sociales.
        </p>

        <!-- Social Grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-3xl mx-auto">
            
            <!-- YouTube -->
            <a href="https://youtube.com/@tutelopezmusic" target="_blank" class="glass-panel p-8 group hover:-translate-y-2 transition-all hover:border-red-500/50">
                <div class="w-16 h-16 rounded-full bg-red-500/10 flex items-center justify-center mx-auto mb-4 group-hover:bg-red-500/20 transition-colors">
                    <svg class="w-8 h-8 text-red-500" fill="currentColor" viewBox="0 0 24 24"><path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"/></svg>
                </div>
                <h3 class="font-bold text-lg text-white mb-1">YouTube</h3>
                <p class="text-sm text-slate-400">Tutoriales y Demos</p>
            </a>

            <!-- Telegram -->
            <a href="https://t.me/tutelopezmusic" target="_blank" class="glass-panel p-8 group hover:-translate-y-2 transition-all hover:border-blue-400/50">
                <div class="w-16 h-16 rounded-full bg-blue-400/10 flex items-center justify-center mx-auto mb-4 group-hover:bg-blue-400/20 transition-colors">
                    <svg class="w-8 h-8 text-blue-400" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.627 0-12 5.373-12 12s5.373 12 12 12 12-5.373 12-12-5.373-12-12-12zm5.894 8.221l-1.97 9.28c-.145.658-.537.818-1.084.508l-3-2.21-1.446 1.394c-.14.18-.357.223-.548.223l.188-2.85 5.18-4.686c.223-.195-.054-.304-.346-.109l-6.4 4.025-2.76-.864c-.602-.19-.611-.603.125-.89l10.77-4.153c.498-.19.923.115.78.832z"/></svg>
                </div>
                <h3 class="font-bold text-lg text-white mb-1">Telegram</h3>
                <p class="text-sm text-slate-400">Canal y Comunidad</p>
            </a>

            <!-- TikTok -->
            <a href="https://tiktok.com/@tutelopezmusic" target="_blank" class="glass-panel p-8 group hover:-translate-y-2 transition-all hover:border-pink-500/50">
                <div class="w-16 h-16 rounded-full bg-pink-500/10 flex items-center justify-center mx-auto mb-4 group-hover:bg-pink-500/20 transition-colors">
                    <svg class="w-8 h-8 text-pink-500" fill="currentColor" viewBox="0 0 24 24"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
                </div>
                <h3 class="font-bold text-lg text-white mb-1">TikTok</h3>
                <p class="text-sm text-slate-400">Tips Rápidos</p>
            </a>

        </div>
    </div>
</MainLayout>
