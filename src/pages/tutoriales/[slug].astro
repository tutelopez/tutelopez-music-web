---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { sanityClient } from 'sanity:client';
import { PortableText } from 'astro-portabletext';

export async function getStaticPaths() {
  const tutorials = await sanityClient.fetch(`*[_type == "tutorial"]{ slug }`);
  
  return tutorials.map((tutorial) => {
    return {
      params: { slug: tutorial.slug.current },
    };
  });
}

const { slug } = Astro.params;

const tutorial = await sanityClient.fetch(`*[_type == "tutorial" && slug.current == $slug][0]{
  title,
  publishedAt,
  body,
  excerpt,
  tags,
  "imageUrl": mainImage.asset->url
}`, { slug });

if (!tutorial) {
  return Astro.redirect('/404');
}
---

<html lang="en">
	<head>
		<BaseHead title={tutorial.title} description={tutorial.excerpt} />
		<style>
			.hero-image {
				width: 100%;
				margin-top: 2rem;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: 0 10px 25px -5px rgba(249, 115, 22, 0.2);
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
		</style>
	</head>

	<body>
		<Header />
		<main class="w-full max-w-[100%] m-0 pt-16">
			<article>
				<div class="hero-image px-4 max-w-5xl mx-auto">
					{tutorial.imageUrl && <img width={1020} height={510} src={tutorial.imageUrl} alt={tutorial.title} class="w-full object-cover" />}
				</div>
				<div class="prose dark:prose-invert prose-strong:text-orange-500 prose-a:text-brand dark:prose-a:text-orange-500 hover:prose-a:text-brand-light prose-a:no-underline hover:prose-a:underline mx-auto max-w-3xl mt-12 px-4">
					<div class="title">
						<div class="date">
							<FormattedDate date={new Date(tutorial.publishedAt)} />
						</div>
						<h1>{tutorial.title}</h1>
                        {tutorial.tags && tutorial.tags.length > 0 && (
                            <div class="flex flex-wrap justify-center gap-2 mt-4 mb-6">
                                {tutorial.tags.map((tag: string) => (
                                    <span class="px-3 py-1 bg-brand/10 text-brand dark:bg-brand/20 text-sm font-semibold rounded-full">
                                        #{tag}
                                    </span>
                                ))}
                            </div>
                        )}
						<hr />
					</div>
                    
                    <!-- Espacio para Anuncio Adsterra Top 728x90 -->
                    <div class="w-full mb-8 flex justify-center overflow-hidden min-h-[90px]">
                        <script is:inline>
                          atOptions = {
                            'key' : '3f1b1c949f78641c3024f8677898e3fe',
                            'format' : 'iframe',
                            'height' : 90,
                            'width' : 728,
                            'params' : {}
                          };
                        </script>
                        <script is:inline src="https://www.highperformanceformat.com/3f1b1c949f78641c3024f8677898e3fe/invoke.js"></script>
                    </div>
                    
                    <PortableText value={tutorial.body} />
                    
                    <!-- Botón de Soporte / Telegram -->
                    <div class="mt-12 pt-8 border-t border-slate-200 dark:border-slate-800 text-center">
                        <p class="text-slate-600 dark:text-slate-300 font-semibold mb-4 text-lg">💬 ¿Tienes dudas o quieres dar las gracias?</p>
                        <a href="https://t.me/tutelopezmusic" target="_blank" class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-[#0088cc] text-white font-bold rounded-lg hover:bg-[#0077b5] transition-colors shadow-lg shadow-[#0088cc]/20 !no-underline">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69.01-.03.01-.14-.07-.18-.08-.05-.19-.02-.27 0-.12.03-1.98 1.25-5.58 3.69-.53.36-1.01.53-1.44.52-.47-.01-1.37-.26-2.03-.48-.82-.27-1.47-.42-1.42-.88.03-.24.3-.49.82-.76 3.2-1.39 5.34-2.31 6.41-2.76 3.05-1.28 3.69-1.5 4.11-1.5.09 0 .29.02.4.1.1.06.18.15.2.27.02.12.02.26.01.37z"/>
                            </svg>
                            Únete a nuestro Grupo de Telegram
                        </a>
                    </div>
                    
                    <!-- Adsterra Native Banner -->
                    <div class="w-full max-w-3xl mx-auto mt-16 mb-8">
                        <script is:inline async="async" data-cfasync="false" src="https://pl30912743.effectivecpmnetwork.com/08d06f7f3ae9c643d3e67ac54e310384/invoke.js"></script>
                        <div id="container-08d06f7f3ae9c643d3e67ac54e310384"></div>
                    </div>
                    
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
