---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import AntiAdblock from '../components/AntiAdblock.astro';

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body class="min-h-screen flex flex-col relative overflow-x-hidden">
        <!-- Google Tag Manager (noscript) -->
        <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-PLTLMT83"
        height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
        <!-- End Google Tag Manager (noscript) -->
        <!-- Background decorative blobs -->
        <div class="fixed inset-0 z-0 pointer-events-none">
            <div class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] rounded-full bg-brand/20 blur-[120px]"></div>
            <div class="absolute bottom-[-10%] right-[-10%] w-[40%] h-[40%] rounded-full bg-purple-600/20 blur-[120px]"></div>
        </div>

		<Header />
		<main class="flex-grow w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-28 pb-12 z-10 relative">
            <slot />
		</main>
		<Footer />
        <AntiAdblock />

        <!-- Floating Telegram Button -->
        <a 
            href="https://t.me/tutelopezmusic" 
            target="_blank" 
            rel="noopener noreferrer"
            class="fixed bottom-6 right-6 z-50 flex items-center justify-center w-14 h-14 bg-[#0088cc] text-white rounded-full shadow-lg shadow-[#0088cc]/40 hover:scale-110 hover:bg-[#0077b5] transition-all duration-300"
            aria-label="Únete a nuestro canal de Telegram"
        >
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="22" y1="2" x2="11" y2="13"></line>
                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
            </svg>
        </a>
        <!-- Adsterra Social Bar (Requiere Consentimiento) -->
        <script type="text/plain" data-category="ads" src="https://pl30912742.effectivecpmnetwork.com/a1/1a/e8/a11ae890108e19a9599a545eb36fa709.js"></script>

        <!-- Vanilla Cookie Consent v3 -->
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orestbida/cookieconsent@v3.0.0/dist/cookieconsent.css">
        <script type="module">
            import 'https://cdn.jsdelivr.net/gh/orestbida/cookieconsent@v3.0.0/dist/cookieconsent.umd.js';
            CookieConsent.run({
                guiOptions: {
                    consentModal: {
                        layout: "bar inline",
                        position: "bottom",
                        equalWeightButtons: true,
                        flipButtons: false
                    },
                    preferencesModal: {
                        layout: "box",
                        position: "right",
                        equalWeightButtons: true,
                        flipButtons: false
                    }
                },
                categories: {
                    necessary: { readOnly: true },
                    analytics: {},
                    ads: {}
                },
                language: {
                    default: "es",
                    autoDetect: "browser",
                    translations: {
                        es: {
                            consentModal: {
                                title: "¡Usamos cookies!",
                                description: "Hola, este sitio web utiliza cookies esenciales para garantizar su correcto funcionamiento y cookies de seguimiento (análisis y publicidad) para comprender cómo interactúas con él. Estas últimas solo se configurarán tras tu consentimiento.",
                                acceptAllBtn: "Aceptar todas",
                                acceptNecessaryBtn: "Rechazar todas",
                                showPreferencesBtn: "Gestionar preferencias"
                            },
                            preferencesModal: {
                                title: "Preferencias de Privacidad",
                                acceptAllBtn: "Aceptar todas",
                                acceptNecessaryBtn: "Rechazar todas",
                                savePreferencesBtn: "Guardar preferencias",
                                closeIconLabel: "Cerrar",
                                sections: [
                                    {
                                        title: "Uso de Cookies",
                                        description: "Usamos cookies para mejorar tu experiencia, analizar el tráfico y mostrar anuncios personalizados."
                                    },
                                    {
                                        title: "Cookies Estrictamente Necesarias",
                                        description: "Estas cookies son esenciales para el funcionamiento de la web y no se pueden desactivar.",
                                        linkedCategory: "necessary"
                                    },
                                    {
                                        title: "Análisis y Estadísticas",
                                        description: "Recopilan información anónima sobre cómo usas la web (ej. páginas más visitadas) mediante Google Tag Manager.",
                                        linkedCategory: "analytics"
                                    },
                                    {
                                        title: "Publicidad (Adsterra)",
                                        description: "Se utilizan para mostrarte anuncios más relevantes y ayudarnos a mantener los servidores gratuitos.",
                                        linkedCategory: "ads"
                                    }
                                ]
                            }
                        }
                    }
                }
            });
        </script>
	</body>
</html>
