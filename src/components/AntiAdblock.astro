---
// AntiAdblock.astro
---

<div id="adblock-modal" class="fixed bottom-4 left-4 right-4 md:left-auto md:right-4 md:max-w-md z-[9999] hidden flex-col transition-opacity duration-500">
    <div class="glass-panel p-5 md:p-6 w-full border-l-4 border-red-500 shadow-2xl relative overflow-hidden bg-slate-900/95 backdrop-blur-md rounded-xl">
        <button id="close-adblock" class="absolute top-3 right-3 text-slate-400 hover:text-white transition-colors" aria-label="Cerrar">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
            </svg>
        </button>

        <div class="flex items-start gap-4">
            <div class="w-10 h-10 bg-red-500/20 rounded-full flex items-center justify-center text-red-500 flex-shrink-0 mt-1">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                </svg>
            </div>
            
            <div>
                <h3 class="text-lg font-bold text-white mb-2">Ayúdanos a seguir gratis</h3>
                <p class="text-slate-300 text-sm leading-relaxed mb-3">
                    Notamos que usas un AdBlocker. Todos nuestros recursos son 100% gratuitos y dependemos de la publicidad para mantener los servidores.
                </p>
                <p class="text-xs text-slate-400">
                    Por favor, añade <strong class="text-white">tutelopezmusic.com</strong> a tu lista blanca. ¡Te lo agradeceríamos muchísimo! ❤️
                </p>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const DISMISS_DAYS = 7;
        const STORAGE_KEY = 'adblockDismissedAt';

        const shouldShow = () => {
            const dismissedAt = localStorage.getItem(STORAGE_KEY);
            if (!dismissedAt) return true;
            
            const daysSinceDismiss = (Date.now() - parseInt(dismissedAt)) / (1000 * 60 * 60 * 24);
            return daysSinceDismiss > DISMISS_DAYS;
        };

        const checkAdblock = async () => {
            if (!shouldShow()) return;

            try {
                await fetch('https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js', {
                    method: 'HEAD',
                    mode: 'no-cors',
                    cache: 'no-store'
                });
                checkCosmeticAdblock();
            } catch (error) {
                showModal();
            }
        };

        const checkCosmeticAdblock = () => {
            if (!shouldShow()) return;

            const bait = document.createElement('div');
            bait.className = 'ad-banner adsbygoogle ad-placement';
            bait.style.height = '1px';
            bait.style.width = '1px';
            bait.style.position = 'absolute';
            bait.style.left = '-999px';
            document.body.appendChild(bait);
            
            setTimeout(() => {
                const isBlocked = bait.offsetHeight === 0 || window.getComputedStyle(bait).display === 'none';
                if (isBlocked) {
                    showModal();
                }
                bait.remove();
            }, 100);
        };

        const showModal = () => {
            const modal = document.getElementById('adblock-modal');
            if (modal) {
                modal.classList.remove('hidden');
                modal.classList.add('flex');
                // document.body.style.overflow = 'hidden'; // Removed to not block scroll
            }
        };

        const closeModal = () => {
            const modal = document.getElementById('adblock-modal');
            if (modal) {
                modal.classList.remove('flex');
                modal.classList.add('hidden');
                localStorage.setItem(STORAGE_KEY, Date.now().toString());
            }
        };

        const closeBtn = document.getElementById('close-adblock');
        if (closeBtn) {
            closeBtn.addEventListener('click', closeModal);
        }

        setTimeout(checkAdblock, 500);
    });
</script>
