---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="fixed top-0 w-full z-50 glass-panel border-t-0 border-l-0 border-r-0 rounded-none bg-slate-950/70 backdrop-blur-lg border-b-slate-800 transition-all duration-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-20">
            <!-- Logo -->
            <div class="flex-shrink-0 flex items-center h-full">
                <a href="/" class="group flex items-center">
                    <img src="/images/tl-logo.png?v=2" alt="TL Music" class="h-16 w-auto object-contain group-hover:brightness-125 transition-all" />
                </a>
            </div>

            <!-- Navigation Links -->
            <nav class="hidden md:flex items-center space-x-8">
                <HeaderLink href="/" class="text-sm font-medium text-slate-300 hover:text-white transition-colors">Inicio</HeaderLink>
                <HeaderLink href="/recursos" class="text-sm font-medium text-slate-300 hover:text-white transition-colors">Recursos</HeaderLink>
                <HeaderLink href="/contacto" class="text-sm font-medium text-slate-300 hover:text-white transition-colors">Contacto</HeaderLink>
                
                <!-- Donate Button -->
                <a href="/apoyo" class="ml-4 px-6 py-2 rounded-full bg-gradient-to-r from-yellow-500 to-orange-500 text-white text-sm font-bold shadow-lg shadow-orange-500/30 hover:scale-105 transition-all flex items-center gap-2">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
                    Apoyar
                </a>
            </nav>

            <!-- Mobile menu button -->
            <div class="md:hidden flex items-center">
                <button type="button" class="text-slate-300 hover:text-white focus:outline-none p-2" aria-controls="mobile-menu" aria-expanded="false">
                    <span class="sr-only">Abrir menú principal</span>
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </button>
            </div>
        </div>
    </div>
</header>
