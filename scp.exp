#!/usr/bin/expect -f
set timeout -1
set ip [lindex $argv 0]
set port [lindex $argv 1]
set user [lindex $argv 2]
set password [lindex $argv 3]
set file [lindex $argv 4]
set dest [lindex $argv 5]

spawn scp -o StrictHostKeyChecking=no -P $port $file $user@$ip:$dest
expect {
    "password:" {
        send "$password\r"
        exp_continue
    }
    eof
}
